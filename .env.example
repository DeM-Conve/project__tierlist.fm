GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SERVER_PORT=48123
FRONTEND_PORT=80
FRONTEND_URL=http://localhost
VITE_API_BASE=http://localhost:48123

# Postgres (optional - these are the defaults)
# POSTGRES_DB=yt
# POSTGRES_USER=yt
# POSTGRES_PASSWORD=yt

# Backups (scripts/backup.sh, scripts/restore.sh and the nightly `backup` service).
# Dumps land in ./backups owned by this user - set these to your `id -u` / `id -g`.
BACKUP_UID=1000
BACKUP_GID=1000
# BACKUP_SCHEDULE=@daily   # cron syntax also works, e.g. "0 3 * * *"
# TZ=UTC                   # time zone for the schedule and the dump file names
