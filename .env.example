# Tierlist.fm settings: copy to .env and edit. Everything has a working
# default for a local install at http://localhost except the Google client.
# Older .env files keep working: FRONTEND_URL, FRONTEND_PORT, POSTGRES_DB,
# POSTGRES_USER, POSTGRES_PASSWORD, BACKUP_UID and BACKUP_GID are still read
# when the new name below isn't set.

# --- URL and port ------------------------------------------------------------
# The address people open in the browser - no trailing slash. Google login
# lands back here, and Google's redirect URI is <TIERLIST_URL>/login/oauth2/code/google.
TIERLIST_URL=http://localhost
# The host port the app is published on (the only port it opens).
TIERLIST_PORT=80
# Serve the app under a sub-path, e.g. /tierlist.fm (leading slash, no trailing
# slash; empty = the root). The reverse proxy in front must strip this prefix
# before forwarding and send `X-Forwarded-Prefix: <prefix>` (Traefik's
# StripPrefix middleware does both). Rebuild the frontend after changing it.
# TIERLIST_URL then includes it (http://localhost/tierlist.fm), and so does
# Google's redirect URI (http://localhost/tierlist.fm/login/oauth2/code/google).
# TIERLIST_BASE_PATH=

# --- Google OAuth (required) - see README "Google OAuth credentials" -----------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Database ------------------------------------------------------------------
# Change the password before the first start; it's set when the db is created.
DB_PASSWORD=yt
# DB_USERNAME=yt
# DB_DATABASE_NAME=yt

# --- Data locations ------------------------------------------------------------
# Postgres data: a bare name is a Docker named volume (default `pgdata`), a path
# (./pgdata, /srv/tierlist/pgdata) a folder on this host.
# DB_DATA_LOCATION=pgdata
# Nightly database dumps (and scripts/backup.sh's): a folder on this host.
# BACKUP_LOCATION=./backups

# --- Backups -------------------------------------------------------------------
# The backup service writes its dumps as this user - set to your `id -u` / `id -g`.
PUID=1000
PGID=1000
# BACKUP_SCHEDULE=@daily   # cron syntax also works, e.g. "0 3 * * *"
# TZ=UTC                   # time zone for the schedule and the dump file names

# --- Optional ------------------------------------------------------------------
# The backend's port inside the Compose network (not published).
# SERVER_PORT=48123
